# PostgreSQL — dedicated `rewatch` database
DATABASE_URL="postgresql://rewatch:CHANGEME@localhost:5432/rewatch"

# API
PORT=3020
HOST=127.0.0.1
NODE_ENV=production

# Set to "false" to close self-service signups (existing accounts still work)
REGISTRATION_ENABLED=true

# TMDB — v4 API key (Read Access Token), server-side only
TMDB_API_TOKEN=""
# Language of the base metadata cache (per-user fr/en translations are always fetched)
TMDB_LANGUAGE="en-US"

# Public app URL (used in email links)
APP_URL="http://localhost:5173"

# SMTP — leave SMTP_HOST empty to disable email sending (links are logged instead)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Rewatch <no-reply@example.com>"

# Web Push — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Set to false only when the node port is exposed directly without a reverse
# proxy (otherwise clients could spoof X-Forwarded-For to dodge rate limits).
TRUST_PROXY=true

# ————— Unattended admin provisioning (optional) —————
#
# Set ADMIN_USERNAME to create the operator account at boot instead of signing
# up through the UI. Leave it unset to keep the default behaviour: the first
# account to register on a fresh instance becomes the administrator.
#
# The account is created pre-verified. Unverified accounts are blocked after a
# 7-day grace period, and an instance provisioned this way may have no SMTP at
# all, so the operator would otherwise lock themselves out after a week.
#
# Creating it also closes the "first account wins" window — everyone who signs
# up afterwards is an ordinary user.
#
# Idempotent across restarts. On later boots the account is left alone, except
# that admin is re-granted and the email realigned on ADMIN_EMAIL. If
# ADMIN_USERNAME names an account that already exists, that account is promoted
# rather than duplicated. The password is never rewritten, so one changed in
# the app survives restarts — set it here once, then rotate it in the UI.
#
# Invalid values are logged and skipped rather than fatal: a typo here should
# not put the container in a restart loop.
#
# ADMIN_USERNAME="admin"
# ADMIN_EMAIL="admin@example.com"      # required when creating a new account
# ADMIN_PASSWORD=""                    # required when creating; min 8 chars
# ADMIN_LANGUAGE="en"                  # "en" or "fr"
# ADMIN_TIMEZONE="UTC"                 # IANA zone, e.g. Europe/Madrid
#
# ADMIN_EMAIL and ADMIN_PASSWORD each accept an _FILE variant naming a file
# that holds the value, so the password need not sit in the compose file or in
# `docker inspect` output:
# ADMIN_PASSWORD_FILE="/run/secrets/rewatch_admin_password"
