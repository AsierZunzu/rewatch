# PostgreSQL — dedicated `rewatch` database
DATABASE_URL="postgresql://rewatch:CHANGEME@localhost:5432/rewatch"

# API
PORT=3020
HOST=127.0.0.1
NODE_ENV=production

# Set to "false" to close self-service signups (existing accounts still work)
REGISTRATION_ENABLED=true

# TMDB — v4 API key (Read Access Token), server-side only
TMDB_API_TOKEN=""
# Language of the base metadata cache (per-user fr/en translations are always fetched)
TMDB_LANGUAGE="en-US"

# Public app URL (used in email links)
APP_URL="http://localhost:5173"

# SMTP — leave SMTP_HOST empty to disable email sending (links are logged instead)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Rewatch <no-reply@example.com>"

# Web Push — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Trakt.tv OAuth app (Settings → Your API Apps), for two-way sync
TRAKT_CLIENT_ID=""
TRAKT_CLIENT_SECRET=""

# Optional legal/privacy page: who runs this instance and how to reach them.
# Only worth filling in if other people have accounts here.
LEGAL_HOST=""
LEGAL_CONTACT=""

# Let the API serve the built frontend itself instead of nginx/Caddy
# STATIC_DIR="../frontend/dist"

# Set to false only when the node port is exposed directly without a reverse
# proxy (otherwise clients could spoof X-Forwarded-For to dodge rate limits).
TRUST_PROXY=true

# ————— Unattended admin provisioning (optional) —————
# Set ADMIN_USERNAME to create the operator account at boot instead of signing
# up through the UI. Idempotent: on later boots the account is left alone,
# except that it is (re-)granted admin and its email realigned on ADMIN_EMAIL.
# The password is never rewritten, so one changed in the app survives restarts.
# Leave ADMIN_USERNAME unset to keep the default "first account to register
# becomes the administrator" behaviour.
# ADMIN_USERNAME="admin"
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD=""
# ADMIN_LANGUAGE="en"      # "en" or "fr"
# ADMIN_TIMEZONE="UTC"     # IANA zone, e.g. Europe/Madrid
#
# ADMIN_PASSWORD and ADMIN_EMAIL also accept a _FILE variant pointing at a file
# holding the value, for Docker/podman secrets:
# ADMIN_PASSWORD_FILE="/run/secrets/rewatch_admin_password"
